# ============================================================
# Kwabo Order Intake — environment variables
# Copy to `.env` and fill in. `.env` is git-ignored.
# ============================================================

# --- LLM (Anthropic Claude) ---------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Database -----------------------------------------------
# Local dev (default):
DATABASE_URL=sqlite:///./kwabo.db
#
# Supabase Postgres (production / Railway). Use the **transaction pooler**
# (port 6543) for serverless / short-lived workers:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Find the exact string in Supabase Dashboard → Project Settings → Database
# → Connection string → "Transaction pooler" (URI tab).
#
# --- Supabase project (frontend / client-side) --------------
# These are safe to expose; the anon key is meant for browser use.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<eyJ...>              # public anon JWT — safe in frontend
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only — NEVER expose to the browser. Bypasses RLS.
# SUPABASE_SERVICE_ROLE_KEY=<eyJ...>

# --- Logging / observability --------------------------------
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=kwabo-order-intake
# LANGCHAIN_API_KEY=...                 # required when TRACING_V2=true

# --- Email source -------------------------------------------
# Modes: file_drop | graph | imap (imap not yet implemented)
EMAIL_MODE=file_drop
INBOX_DIR=../data/inbox
PROCESSED_DIR=../data/processed
# Microsoft Graph mailbox (only when EMAIL_MODE=graph). The OAuth flow is
# at /api/mailbox/oauth/start; tokens are persisted in the OAuthToken
# table. Configuration is stored in the OAuthConfig DB row, set via the
# /email page in the dashboard or PUT /api/mailbox/oauth/config.
# Required Azure AD app permissions (Microsoft Graph, delegated):
#   Mail.ReadWrite, User.Read, offline_access  — admin consent required.
# Redirect URI registered in Azure must match GRAPH_REDIRECT_URI below.
# GRAPH_REDIRECT_URI=http://localhost:8000/api/mailbox/oauth/callback

# --- Navision target ----------------------------------------
# Modes: mock | replay | real | nav2018
NAVISION_MODE=mock
NAVISION_MOCK_DIR=../data/navision_mock

# --- NAV 2018 OData V4 (Pilex/Kwabo test environment) -------
# Active when NAVISION_MODE=nav2018. Use the OData V4 (port 1153) endpoint
# because port 1143 advertises Digest auth, which httpx doesn't support
# out of the box. Basic auth on V4 works with the Web Service Access Key.
# NAV_BASE_URL=https://sf-112840.dynamicstocloud.com:1153/ST-124593-WS/ODataV4
# NAV_COMPANY=Kopie 2023 Kwabo Techniek B.V.   # display name with spaces, no quoting
# NAV_USERNAME=<service-user>
# NAV_PASSWORD=<web-service-access-key>        # 28+ char alnum string from NAV
# NAV_VERIFY_SSL=true                          # false ONLY for self-signed staging
# Custom page (entity) names exposed in NAV (PLX_ defaults match the test env).
# NAV_PAGE_SALES_ORDER=PLX_SalesOrder
# NAV_PAGE_SALES_ORDER_LINES=PLX_SalesOrderLines
# NAV_PAGE_CUSTOMER=PLX_Customer
# NAV_PAGE_ITEM=PLX_Item
# NAV_PAGE_ITEM_REFERENCE=PLX_ItemReference
# NAV_PAGE_SHIP_TO=PLX_ShipToAddress
# NAV_PAGE_ITEM_UOM=PLX_ItemUnitOfMeasure

# --- Real NAV 2018 OData v2 (Business Central / older) ------
# Active when NAVISION_MODE=real. The original BC-style client.
# NAV_BASE_URL=https://nav.example.com:7048/NAV/api/v2.0
# NAV_COMPANY_ID=<company-guid>
# NAV_AUTH_MODE=basic                   # basic | oauth
# NAV_USERNAME=<service-user>
# NAV_PASSWORD=<web-service-key>
# NAV_TENANT_ID=<aad-tenant>            # oauth only
# NAV_CLIENT_ID=<aad-client>
# NAV_CLIENT_SECRET=<aad-secret>
# NAV_SCOPE=https://api.businesscentral.dynamics.com/.default

# --- Admin auth ---------------------------------------------
# Single shared password gate. The frontend's /login page POSTs to
# /api/auth/login with this value; on success it stores a HMAC bearer
# token in a same-origin cookie (Vercel domain) for ~24h.
# Leave empty in dev to bypass auth entirely.
ADMIN_PASSWORD=
# 32+ random chars; rotate to invalidate every existing session.
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_TTL_HOURS=24
